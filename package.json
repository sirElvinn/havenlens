{
  "name": "havenlens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "context": "node --env-file-if-exists=.env.local scripts/context.mjs",
    "dossiers": "python3 -I scripts/dossiers.py",
    "api": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "preview": "node --env-file-if-exists=.env.local scripts/serve.mjs --static",
    "precache": "node scripts/precache.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/leaflet": "^1.9.12",
    "@types/qrcode": "^1.5.5",
    "geist": "^1.9.2",
    "leaflet": "^1.9.4",
    "next": "^16",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "axe-core": "^4.10.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
